    {
      "name": "a fold replaces what came before it",
      "why": "Drawing turns the model no longer has shows a conversation the agent cannot remember, and the next answer looks like amnesia rather than compaction.",
      "events": [
        {
          "seq": 1,
          "kind": "user.message",
          "body": {
            "message_id": "msg_1",
            "text": "first"
