  "cases": [
    {
      "name": "deltas are joined into one message",
      "why": "A client that draws each delta shows one word per line. They are pieces of a message, not messages.",
      "events": [
        {
          "seq": 1,
          "kind": "user.message",
          "body": {
            "message_id": "msg_1",
            "text": "hello"
          }
        },
        {
          "seq": 2,
          "kind": "assistant.delta",
          "body": {
            "message_id": "msg_2",
            "text": "Hel"
          }
        },
        {
          "seq": 3,
          "kind": "assistant.delta",
          "body": {
            "message_id": "msg_2",
            "text": "lo the"
          }
        },
        {
          "seq": 4,
          "kind": "assistant.delta",
          "body": {
            "message_id": "msg_2",
            "text": "re."
          }
        },
        {
          "seq": 5,
          "kind": "assistant.completed",
          "body": {
            "message_id": "msg_2"
          }
        }
      ],
      "expected": {
        "messages": [
          {
            "role": "user",
            "text": "hello"
          },
          {
            "role": "assistant",
            "text": "Hello there."
          }
        ],
        "pending_approvals": null,
        "active_run": "",
        "head_seq": 5
      }
    },
    {
      "name": "the working-out is kept apart from the answer",
      "why": "It arrives before the turn has any text, so a client that joined the two would open the reply with the thinking and then forward the whole thing as the answer.",
      "events": [
        {
          "seq": 1,
          "kind": "user.message",
          "body": {
            "message_id": "msg_1",
            "text": "what time is it in Taipei?"
          }
        },
        {
          "seq": 2,
          "kind": "assistant.reasoning",
          "body": {
            "message_id": "msg_2",
            "text": "They did not say where they are. "
          }
        },
        {
          "seq": 3,
          "kind": "assistant.reasoning",
          "body": {
            "message_id": "msg_2",
            "text": "Taipei is UTC+8, no daylight saving."
          }
        },
        {
          "seq": 4,
          "kind": "assistant.delta",
          "body": {
            "message_id": "msg_2",
            "text": "It is 14:20 in Taipei."
          }
        },
        {
          "seq": 5,
          "kind": "assistant.completed",
          "body": {
            "message_id": "msg_2"
          }
        }
      ],
      "expected": {
        "messages": [
          {
            "role": "user",
            "text": "what time is it in Taipei?"
          },
          {
            "role": "assistant",
            "text": "It is 14:20 in Taipei.",
            "reasoning": "They did not say where they are. Taipei is UTC+8, no daylight saving."
          }
        ],
        "pending_approvals": null,
        "active_run": "",
        "head_seq": 5
      }
    },
    {
      "name": "a tool call belongs to the turn that asked for it",
      "why": "Drawn as its own entry, a call floats between turns and a reader cannot tell which request caused it.",
      "events": [
        {
          "seq": 1,
          "kind": "user.message",
          "body": {
            "message_id": "msg_1",
            "text": "read it"
          }
        },
        {
          "seq": 2,
          "kind": "assistant.delta",
          "body": {
            "message_id": "msg_2",
            "text": "Looking."
          }
        },
        {
          "seq": 3,
          "kind": "tool.requested",
          "body": {
            "call_id": "call_1",
            "name": "read_file"
          }
        },
        {
          "seq": 4,
          "kind": "tool.completed",
          "body": {
            "call_id": "call_1",
            "is_error": false,
            "name": "read_file"
          }
        },
        {
          "seq": 5,
          "kind": "assistant.completed",
          "body": {
            "message_id": "msg_2"
          }
        }
      ],
      "expected": {
        "messages": [
          {
            "role": "user",
            "text": "read it"
          },
          {
            "role": "assistant",
            "text": "Looking.",
            "tool_calls": [
              {
                "name": "read_file",
                "completed": true,
                "is_error": false
              }
            ]
          }
        ],
        "pending_approvals": null,
        "active_run": "",
        "head_seq": 5
      }
    },
